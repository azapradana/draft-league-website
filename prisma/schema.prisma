generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PLAYER
  ADMIN
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  PENDING
  COMPLETED
  DISPUTED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  SWISS
}

enum TournamentStage {
  SINGLE_ELIMINATION
  SWISS
  TOP_CUT
  COMPLETED
}

model User {
  id            String                  @id @default(cuid())
  username      String?                 @unique
  name          String?
  email         String?                 @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  googleEmail   String?
  role          Role                    @default(PLAYER)
  coinsBalance  Int                     @default(0)
  accounts      Account[]
  sessions      Session[]
  participants  Participant[]
  matchMessages MatchMessage[]
  prizePayouts  TournamentPrizePayout[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SiteSettings {
  id                  String  @id @default("global")
  siteTitle           String  @default("Draft League")
  heroHeadline        String  @default("Your next great draft starts here.")
  heroSubheading      String  @default("Build your roster, challenge the field, and make your run count.")
  heroBackgroundImage String?
  faviconUrl          String?
  siteLogoUrl         String?
  accentColor         String  @default("#F5C542")
  initialPlayerCoins  Int     @default(500)
}

model Tournament {
  id                 String                  @id @default(cuid())
  name               String
  description        String                  @default("")
  format             TournamentFormat        @default(SINGLE_ELIMINATION)
  topCut             Int                     @default(0)
  currentStage       TournamentStage         @default(SINGLE_ELIMINATION)
  maxParticipants    Int?
  swissRounds        Int                     @default(4)
  imageUrl           String?
  cardBackImage      String?
  active             Boolean                 @default(false)
  completed          Boolean                 @default(false)
  regulation         String                  @default("m-c")
  startingCoins      Int                     @default(0)
  coinPrizePool      Int                     @default(0)
  prizeWinnersCount  Int                     @default(0)
  prizeDistribution  Json                    @default("[]")
  maxCopiesPerPlayer Int                     @default(3)
  maxCopiesLeague    Int?
  rostersLocked      Boolean                 @default(false)
  rostersPublic      Boolean                 @default(false)
  checkInOpen        Boolean                 @default(false)
  participants       Participant[]
  packs              TournamentPack[]
  matches            Match[]
  prizePayouts       TournamentPrizePayout[]
}

model Participant {
  id             String                  @id @default(cuid())
  userId         String
  tournamentId   String
  status         ParticipantStatus       @default(PENDING)
  checkedIn      Boolean                 @default(false)
  coins          Int                     @default(0)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament     Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  ownedPokemon   OwnedPokemon[]
  roster         Roster?
  player1Matches Match[]                 @relation("MatchPlayer1")
  player2Matches Match[]                 @relation("MatchPlayer2")
  wonMatches     Match[]                 @relation("MatchWinner")
  player1Votes   Match[]                 @relation("MatchPlayer1Vote")
  player2Votes   Match[]                 @relation("MatchPlayer2Vote")
  prizePayouts   TournamentPrizePayout[]

  @@unique([userId, tournamentId])
}

model TournamentPrizePayout {
  id            String      @id @default(cuid())
  tournamentId  String
  participantId String
  userId        String
  place         Int
  amount        Int
  createdAt     DateTime    @default(now())
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, participantId])
  @@index([userId, createdAt])
}

model Match {
  id              String           @id @default(cuid())
  tournamentId    String
  roundNumber     Int
  stage           TournamentStage?
  bracketPosition Int?
  player1Id       String?
  player2Id       String?
  winnerId        String?
  player1Vote     String?
  player2Vote     String?
  status          MatchStatus      @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1         Participant?     @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2         Participant?     @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  winner          Participant?     @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  player1Voted    Participant?     @relation("MatchPlayer1Vote", fields: [player1Vote], references: [id], onDelete: SetNull)
  player2Voted    Participant?     @relation("MatchPlayer2Vote", fields: [player2Vote], references: [id], onDelete: SetNull)
  messages        MatchMessage[]

  @@index([tournamentId, roundNumber])
}

model MatchMessage {
  id         String   @id @default(cuid())
  matchId    String
  senderId   String
  senderName String
  content    String
  timestamp  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Species {
  dex          Int            @id
  name         String         @unique
  types        String[]       @default([])
  isMega       Boolean        @default(false)
  imageUrl     String?
  packEntries  PackEntry[]
  ownedPokemon OwnedPokemon[]
}

model Pack {
  id          String           @id @default(cuid())
  name        String
  description String           @default("")
  packImage   String?
  pullCount   Int              @default(1)
  tiers       PackTier[]
  entries     PackEntry[]
  purchases   Purchase[]
  tournaments TournamentPack[]
}

model TournamentPack {
  tournamentId  String
  packId        String
  price         Int        @default(0)
  purchaseLimit Int?
  active        Boolean    @default(false)
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pack          Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([tournamentId, packId])
  @@index([packId])
}

model PackTier {
  id         String      @id @default(cuid())
  packId     String
  name       String
  weight     Decimal     @db.Decimal(10, 4)
  color      String
  minimumOne Boolean     @default(false)
  pack       Pack        @relation(fields: [packId], references: [id], onDelete: Cascade)
  entries    PackEntry[]
}

model PackEntry {
  id         String   @id @default(cuid())
  packId     String
  speciesDex Int
  tierId     String
  pack       Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  species    Species  @relation(fields: [speciesDex], references: [dex], onDelete: Cascade)
  tier       PackTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([packId, speciesDex])
}

model Purchase {
  id            String         @id @default(cuid())
  participantId String
  packId        String
  cost          Int
  timestamp     DateTime       @default(now())
  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pack          Pack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  ownedPokemon  OwnedPokemon[]
}

model OwnedPokemon {
  id            String      @id @default(cuid())
  participantId String
  speciesDex    Int
  purchaseId    String
  tierName      String?
  tierColor     String?
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  species       Species     @relation(fields: [speciesDex], references: [dex], onDelete: Cascade)
  purchase      Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Roster {
  id            String      @id @default(cuid())
  participantId String      @unique
  speciesIds    Int[]       @default([])
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}
