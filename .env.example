DATABASE_URL="postgresql://draft:draft@localhost:5432/draft?schema=public"
DATABASE_URL_UNPOOLED="postgresql://draft:draft@localhost:5432/draft?schema=public"
# Production DATABASE_URL should use your provider's pooled endpoint (Neon URLs should use the -pooler host).
# Prisma defaults to a pool of 5 connections and a 10-second pool wait; URL parameters can override these.
# Keep DATABASE_URL_UNPOOLED on the direct endpoint for Prisma migrations.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Optional: set both values to enable Google sign-in and sign-up.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BLOB_READ_WRITE_TOKEN="replace-with-a-vercel-blob-token"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
